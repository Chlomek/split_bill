# ==============================================================================
# Split Bill - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Supabase Configuration
# Found in: Supabase Project Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Edge Functions URL (Optional if using Supabase client default)
# SUPABASE_EDGE_FUNCTIONS_URL=https://your-project-id.supabase.co/functions/v1

# Deep Linking / Universal Links Domain
APP_DOMAIN=splitbill.app

# RevenueCat API Keys (Freemium monetization & quota enforcement)
# Found in: RevenueCat Dashboard -> Project -> API Keys
REVENUECAT_APPLE_API_KEY=appl_your_apple_api_key_here
REVENUECAT_GOOGLE_API_KEY=goog_your_google_api_key_here

# AI Receipt Scanning Service (Optional: only needed if calling AI models directly without Edge Function)
# GEMINI_API_KEY=your_gemini_api_key_here
